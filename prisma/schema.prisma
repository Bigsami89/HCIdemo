generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id        String   @id @default(cuid())
  nombre    String
  apellidos String
  email     String   @unique
  password  String
  empresa   String
  createdAt DateTime @default(now())
  cursos    Curso[]
}

model Curso {
  id          String    @id @default(cuid())
  titulo      String
  descripcion String
  imagenUrl   String?
  duracion    String?
  createdAt   DateTime  @default(now())
  usuarios    Usuario[]
}